# Copie para .env.local. Preencha no ambiente, nunca no Git.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor: rate limiting e job. Nunca NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
API_FOOTBALL_KEY=
CRON_SECRET=
# Secret local de 32 bytes aleatórios, codificados em 64 caracteres hex (não placeholder de proxy).
RECOVERY_SIGNING_SECRET=
# Defina a temporada explicitamente após conferir cobertura e licença.
# Não presumir temporada atual disponível no Free; escolha após descoberta.
SPORTS_SEASON=
API_FOOTBALL_DAILY_BUDGET=70
API_FOOTBALL_MINUTE_BUDGET=8
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_MINUTE_LIMIT=10
API_FOOTBALL_OPERATIONAL_RESERVE=30
API_FOOTBALL_PRIORITY_RESERVE=6
# Só funciona com next dev/test; recusado em produção.
LOCAL_DEMO=false
